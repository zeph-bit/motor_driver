	(text "STM32 Header Circuit"
		(exclude_from_sim no)
		(at 30.734 69.342 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "fea27358-f31e-446a-ba6c-7e578aefd669")
	)
	(text_box "Description\nA motor driver board designed to faciliate control of a Pololu brushed DC motor with a STM32F072 DISCOVERY board.\nA L298N H-bridge driver provides an interface between the motors and STM32.\nThe LM75A temperature sensor enables monitoring of the H-bridge driver circuit temperature.\nA current sense resistor connected to the L298N enables the STM32 to determine the power used by the motors for the purpose of estimating the motor speed.\n\nRevision History\nRev 1: Schematic creation.\nRev 2: Major Corrections and Additions\n		- C1 now connects to +6V instead of +3V3\n		- A0, A1, A2 now connect to GND\n		- Pull-up resistor connected to A0, A1, A2 now connects to EnA, EnB on L298N\n	   	- Updated footprints for barrel jack and headers\n	   Minor Corrections and Additions\n		- Swapped MTR_BLK and MTR_RED labels in Motor Header Circuit to match header pins\n		- Moved C1 and C2 to Power Circuit for better circuit appearance\n		- Added Description and Revision History"
		(exclude_from_sim no)
		(at 177.165 125.095 0)
		(size 107.315 40.64)
		(margins 0.9525 0.9525 0.9525 0.9525)
